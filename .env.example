# --- kinopoisk.dev (маппинг KP id -> tmdb/imdb id) ---
# Токен бесплатно: Telegram-бот @kinopoiskdev_bot -> /start -> прислать /token
KINOPOISK_DEV_TOKEN=

# --- TMDB ---
# v3 API key: https://www.themoviedb.org/settings/api (тип "API Key (v3)")
TMDB_API_KEY=

# Session id. Вручную НЕ заполнять — скрипт сам:
#   python migrate.py login-tmdb
TMDB_SESSION_ID=

# Опционально: путь к exe реального Chromium-браузера, если Playwright Chromium
# ловит капчу. Пример: C:\Users\Administrator\AppData\Local\imput\Helium\Application\chrome.exe
KP_BROWSER_PATH=