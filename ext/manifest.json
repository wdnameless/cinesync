{
  "manifest_version": 3,
  "name": "CineSync — Movie Ratings & Watchlist Sync",
  "version": "3.2.0",
  "description": "Перенос оценок и списка «Буду смотреть» между Кинопоиском, TMDB, Simkl, Letterboxd, IMDb и MovieLens.",
  "permissions": [
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "*://*.kinopoisk.ru/*",
    "*://*.themoviedb.org/*",
    "*://*.simkl.com/*",
    "*://*.kinopoiskapiunofficial.tech/*"
  ],
  "action": {
    "default_popup": "dist/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  }
}
